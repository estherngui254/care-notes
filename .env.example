# Optional. Copy this file to .env.local to point the app at a different Supabase project.
# Without it, the app uses the project set in src/supabaseConfig.js.
#
# Only ever use the PUBLISHABLE key here (it starts with sb_publishable_). It is meant to be public.
# NEVER put the secret key (sb_secret_...), the service_role key or the database password in this app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
